{
  "preset_name": "jewellery_image",
  "enabled": true,
  "input": {
    "allowed_formats": [
      "jpg",
      "jpeg",
      "png",
      "webp"
    ],
    "max_file_size_mb": 20,
    "min_resolution_px": 500
  },
  "background_removal": {
    "enabled": true,
    "method": "ai_background_removal",
    "backend": "local",
    "model": "bria-rmbg",
    "fallback_to_local": true,
    "prompt": "jewelry",
    "remove_inner_holes": true,
    "output_background": "transparent",
    "fallback_background": "#FFFFFF",
    "preserve_product_edges": true,
    "preserve_diamond_facets": true,
    "preserve_prongs_and_claws": true,
    "preserve_chain_details": true,
    "preserve_small_components": true,
    "remove_background_shadows": true,
    "preserve_natural_product_shadows": false,
    "remove_reflections": false,
    "foreground_estimation": {
      "enabled": true,
      "highlight_threshold": 220
    },
    "hole_core_tolerance": 20.0,
    "hole_grow_tolerance": 42.0,
    "hole_flat_gradient": 22.0,
    "hole_fringe_iterations": 1,
    "contour_hole_min_area_px": 16,
    "contour_hole_alpha_threshold": 8,
    "border_background_tolerance": 32.0,
    "border_background_gradient": 18.0,
    "detection": {
      "model": "u2netp",
      "enabled": true,
      "detector": "saliency",
      "prompt": "jewelry",
      "refine": true,
      "refine_margin": 0.12
    },
    "recover_thin_details": true,
    "remove_specks": true
  },
  "product_protection": {
    "preserve_original_shape": true,
    "preserve_original_color": true,
    "preserve_gold_tone": true,
    "preserve_diamond_color": true,
    "preserve_source_rgb": true,
    "preserve_diamond_shape": true,
    "preserve_gemstone_color": true,
    "preserve_stone_count": true,
    "preserve_setting_details": true,
    "no_product_redesign": true,
    "no_artificial_gemstones": true,
    "no_detail_smoothing": true,
    "preserve_facet_boundaries": true,
    "no_artificial_sparkle": true,
    "alpha_floor": 0,
    "edge_recovery": false,
    "highlight_alpha_recovery": true,
    "highlight_threshold": 212,
    "alpha_expand_px": 0,
    "highlight_alpha_seed": 8,
    "max_highlight_distance_px": 8,
    "sparkle_min_alpha": 214,
    "recover_zero_alpha_sparkle": true,
    "zero_alpha_seed": 24,
    "max_edge_cleanup": 0.08,
    "facet_edge_threshold": 18,
    "facet_brightness_threshold": 138,
    "facet_min_alpha": 202,
    "remove_white_edge": false,
    "use_estimated_foreground_rgb": true,
    "white_edge_neutral_tolerance": 18,
    "white_edge_brightness": 185
  },
  "image_processing": {
    "auto_crop": true,
    "crop_mode": "product_centered",
    "maintain_aspect_ratio": true,
    "add_padding": true,
    "padding_percent": 10,
    "auto_rotate": true,
    "sharpen": false,
    "denoise": false,
    "brightness_adjustment": false,
    "contrast_adjustment": false,
    "saturation_adjustment": false,
    "max_upscale": 2.0
  },
  "output": {
    "format": "png",
    "width_px": 1750,
    "height_px": 1160,
    "resize_mode": "contain",
    "background_color": "transparent",
    "color_mode": "RGBA",
    "preserve_transparency": true,
    "output_folder": "processed/jewellery"
  },
  "validation": {
    "reject_corrupt_images": true,
    "warn_if_product_is_cut_off": true,
    "warn_if_product_is_blurry": true,
    "warn_if_multiple_products_detected": false,
    "require_product_visible": true
  },
  "per_image_overrides": {
    "k-05684": {
      "product_protection": {
        "alpha_expand_px": 0,
        "highlight_alpha_seed": 4,
        "max_highlight_distance_px": 10,
        "recover_zero_alpha_sparkle": true,
        "zero_alpha_seed": 1,
        "highlight_threshold": 180,
        "sparkle_min_alpha": 255,
        "facet_min_alpha": 220,
        "remove_white_edge": false
      }
    },
    "71249": {
      "reference_matte": "media/Transparent/71249-P.png",
      "output": {
        "width_px": 2400,
        "height_px": 1610
      }
    },
    "87450": {
      "reference_matte": "media/Transparent/87450_rem.png",
      "use_reference_rgb": true,
      "repair_regions": [
        [
          0.285,
          0.465,
          0.315,
          0.525
        ],
        [
          0.665,
          0.465,
          0.695,
          0.525
        ],
        [
          0.34,
          0.68,
          0.37,
          0.735
        ],
        [
          0.465,
          0.82,
          0.5,
          0.87
        ]
      ]
    }
  }
}
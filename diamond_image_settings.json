{
  "preset_name": "diamond_image",
  "enabled": true,
  "input": {
    "allowed_formats": [
      "jpg",
      "jpeg",
      "png",
      "webp"
    ],
    "max_file_size_mb": 20,
    "min_resolution_px": 500
  },
  "background_removal": {
    "enabled": true,
    "method": "ai_background_removal",
    "backend": "local",
    "model": "bria-rmbg",
    "fallback_to_local": true,
    "prompt": "diamond",
    "remove_inner_holes": true,
    "output_background": "transparent",
    "fallback_background": "#FFFFFF",
    "preserve_product_edges": true,
    "preserve_diamond_facets": true,
    "preserve_prongs_and_claws": true,
    "preserve_small_components": true,
    "remove_background_shadows": true,
    "preserve_natural_product_shadows": false,
    "remove_reflections": false,
    "foreground_estimation": {
      "enabled": false,
      "highlight_threshold": 220
    },
    "detection": {
      "model": "u2netp",
      "enabled": true,
      "detector": "saliency",
      "prompt": "diamond",
      "refine": true,
      "refine_margin": 0.12
    },
    "recover_thin_details": true,
    "remove_specks": true,
    "protect_on_white_backdrop": true,
    "white_guard_model_alpha": 220,
    "hole_filled_min_area_ratio": 1.0
  },
  "product_protection": {
    "preserve_original_shape": true,
    "preserve_original_color": true,
    "preserve_diamond_color": true,
    "preserve_source_rgb": true,
    "preserve_diamond_shape": true,
    "preserve_inclusions_and_natural_characteristics": true,
    "preserve_facet_boundaries": true,
    "no_product_redesign": true,
    "no_artificial_sparkle": true,
    "no_artificial_gemstones": true,
    "no_detail_smoothing": true,
    "preserve_stone_count": true,
    "preserve_setting_details": true,
    "preserve_gold_tone": true,
    "alpha_floor": 0,
    "edge_recovery": false,
    "highlight_alpha_recovery": true,
    "highlight_threshold": 195,
    "alpha_expand_px": 0,
    "highlight_alpha_seed": 8,
    "max_highlight_distance_px": 12,
    "sparkle_min_alpha": 255,
    "recover_zero_alpha_sparkle": true,
    "zero_alpha_seed": 12,
    "solid_core_threshold": 128,
    "solid_core_alpha": 255,
    "haze_cutoff_alpha": 110,
    "haze_body_seed": 200,
    "haze_max_distance_px": 10,
    "remove_white_edge": false,
    "use_estimated_foreground_rgb": false,
    "max_edge_cleanup": 0.08,
    "facet_edge_threshold": 18,
    "facet_brightness_threshold": 138,
    "facet_min_alpha": 202
  },
  "image_processing": {
    "auto_crop": true,
    "crop_mode": "product_centered",
    "maintain_aspect_ratio": true,
    "add_padding": true,
    "padding_percent": 10,
    "auto_rotate": true,
    "sharpen": false,
    "denoise": false,
    "brightness_adjustment": false,
    "contrast_adjustment": false,
    "saturation_adjustment": false,
    "max_upscale": 2.0
  },
  "output": {
    "format": "png",
    "width_px": 1750,
    "height_px": 1160,
    "resize_mode": "contain",
    "background_color": "transparent",
    "color_mode": "RGBA",
    "preserve_transparency": true,
    "output_folder": "processed/diamonds"
  },
  "validation": {
    "reject_corrupt_images": true,
    "warn_if_product_is_cut_off": true,
    "warn_if_product_is_blurry": true,
    "require_product_visible": true
  }
}